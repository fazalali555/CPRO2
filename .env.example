# ---------------------------------------------------------------------------
# Clerk Pro — environment template
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Port Configuration
VITE_PORT=3003

# App Configuration
VITE_APP_NAME=Clerk Pro by Fazal Ali
VITE_APP_SHORT_NAME=Clerk Pro
VITE_APP_VERSION=0.0.1
VITE_APP_AUTHOR=Fazal Ali
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=http://localhost:3000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_OFFLINE_MODE=true
VITE_AUTO_BACKUP_INTERVAL=86400000

# Security
VITE_SECURE_COOKIES=true
VITE_CSP_ENABLED=true

# ---------------------------------------------------------------------------
# AI / Gemini
# ---------------------------------------------------------------------------
# Preferred: leave VITE_GEMINI_API_KEY unset and run the bundled Node server
# (server/index.js), which keeps the key server-side and exposes
# POST /api/ai/compose-letter. Setting a VITE_ key bakes it into the public JS
# bundle where anyone can read it.
VITE_GEMINI_API_KEY=

# Server-side key used by server/geminiService.js — required for the AI endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=30000
# Optional JSON array overriding the default BLOCK_MEDIUM_AND_ABOVE thresholds,
# e.g. [{"category":"HARM_CATEGORY_HATE_SPEECH","threshold":"BLOCK_LOW_AND_ABOVE"}]
GEMINI_SAFETY_SETTINGS=

# ---------------------------------------------------------------------------
# AI server (server/index.js)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Comma-separated exact-match CORS allow list. Set this in production; the
# localhost defaults are for local development only.
CORS_ORIGIN=http://localhost:3003,http://localhost:5173

# Rate limiting applied to /api/*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# In-memory async job store bounds (server/jobStore.js)
JOB_STORE_MAX_JOBS=500
JOB_STORE_TTL_MS=3600000

# Append-only audit trail
AUDIT_LOG_PATH=./logs/audit.log
