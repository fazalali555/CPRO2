{
  "name": "clerk-pro",
  "description": "Clerk Pro by Fazal Ali - Professional Clerking System",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:server": "node --watch server/index.js",
    "start:server": "node server/index.js",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint src --ext ts,tsx --report-unused-disable-directives --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "deps:audit": "node scripts/audit-gate.mjs",
    "verify": "npm run secrets:scan && npm run type-check && npm run lint && npm run lint:baseline && npm test && npm run build",
    "lint:baseline": "node scripts/lint-baseline.mjs"
  },
